# CareerKonnect AI - backend environment template
#
# Copy this file to backend/.env and fill in real values:
#     cp backend/.env.example backend/.env      (macOS/Linux)
#     Copy-Item backend\.env.example backend\.env   (Windows PowerShell)
#
# backend/.env is gitignored. NEVER put real secrets in this template file,
# and never commit the real .env.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=replace_with_a_long_random_string
DEBUG=True
# Comma-separated. localhost and 127.0.0.1 are always allowed by default.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# If PostgreSQL is unreachable the app automatically falls back to SQLite,
# so local development works without Postgres running.
#
# To use PostgreSQL, start the server and create the database first:
#     createdb careerkonnect
DB_NAME=careerkonnect
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# AI - Google Gemini
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey and paste it below.
#
# This key is read ONLY by the Django backend. It is never sent to the React
# frontend: the browser calls the Django API, and Django calls Gemini.
#     React -> Django REST API -> Google Gemini
GEMINI_API_KEY=

# Model is configurable without touching source code.
# Measured latency on a real resume:
#   gemini-3.5-flash-lite   ~2.5s  (default - fast, good quality)
#   gemini-3.1-flash-lite   ~2.9s
#   gemini-3.5-flash        ~9.4s  (slower, richer analysis)
# Do NOT use "thinking" models such as gemini-3.6-flash here: the same prompt
# takes 200s+ and will exceed the request timeout.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Social Authentication (optional)
# ---------------------------------------------------------------------------
# Leave blank to hide the Google sign-in button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# If EMAIL_HOST_USER is blank, emails print to the Django console instead of
# being sent - which is what you want for local development.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CareerKonnect AI <no-reply@careerkonnect.ai>
